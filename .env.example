# ==============================================================================
# Vasudha App (B-Liffe Frontend) - Environment Template
# ==============================================================================

# Application Branding
VITE_APP_TITLE="B-Liffe - Bharat Local Informatics for Flora, Fauna, and Ecosystems"
VITE_APP_SHORT_NAME="Vasudha"

# Routing Base URL ('/' for CloudFront / S3 root)
VITE_BASE_URL="/"

# ==============================================================================
# Backend API Configuration
# ==============================================================================
# In production on CloudFront, leave empty to use relative '/api' (avoids Mixed Content).
# For custom domain with SSL: https://api.yourdomain.org
VITE_API_URL=
VITE_PORT=5173
VITE_PROXY_TARGET=http://bliffe-api.ap-southeast-2.elasticbeanstalk.com

# ==============================================================================
# Mapbox Token
# ==============================================================================
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_DEFAULT_LATITUDE=8.5241
VITE_DEFAULT_LONGITUDE=76.9366
VITE_DEFAULT_ZOOM=16

# ==============================================================================
# AWS Hosting Details
# ==============================================================================
VITE_AWS_S3_BUCKET=bliffe-frontend-dev
VITE_AWS_CLOUDFRONT_DISTRIBUTION_ID=E22IM021D3GUIA
VITE_CLOUDFRONT_URL=https://d2msowv3rhnqjt.cloudfront.net
