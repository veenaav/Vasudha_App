# ==============================================================================
# Vasudha App (B-Liffe Frontend) - Environment Configuration Template
# ==============================================================================

# Application Information
VITE_APP_TITLE="B-Liffe - Bharat Local Informatics for Flora, Fauna, and Ecosystems"
VITE_APP_SHORT_NAME="Vasudha"

# Backend API Configuration
# Base URL for backend API calls. Leave empty if using Vite proxy (/api)
VITE_API_URL=https://bliffe-api.duckdns.org

# Vite Development Server Settings
VITE_PORT=5173
VITE_PROXY_TARGET=http://localhost:3000

# Mapbox Access Token (for high-definition Mapbox Outdoors v12 tiles)
# Get your free token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Default Map Center Coordinates & Zoom (Thiruvananthapuram, Kerala fallback)
VITE_DEFAULT_LATITUDE=8.5241
VITE_DEFAULT_LONGITUDE=76.9366
VITE_DEFAULT_ZOOM=16
